{
  "architecture": "chatgpt-default-qualified-local-optional",
  "manifest_version": 2,
  "default_reasoning_authority": "chatgpt",
  "execution_layer": "airi-pc",
  "qualified_local_reasoning": {
    "allowed": true,
    "provider": "airi-generalist",
    "requires": [
      "AIRI_GENERALIST_ENABLE=1",
      "exact checkpoint/model qualification",
      "runtime dependencies"
    ],
    "preferred_only_with": "AIRI_GENERALIST_PREFER=1",
    "production_gate": "protected multi-domain benchmark"
  },
  "remote_reasoning_provider_allowed": false,
  "forbidden_reasoning_provider_classes": [
    "unqualified_local_llm",
    "arbitrary_remote_llm",
    "openrouter",
    "ollama",
    "unattested_model_gateway"
  ],
  "bootstrap_order": [
    "manifest",
    "reasoning_policy",
    "reasoning_directive",
    "runtime",
    "verification",
    "execution",
    "persistence",
    "recovery"
  ],
  "runtime": {
    "display": ":99",
    "host": "127.0.0.1",
    "port": 9010,
    "mcp_endpoint": "/mcp",
    "ready_endpoint": "/ready",
    "status_endpoint": "/status",
    "resolution": "1280x800",
    "playwright_browsers_path": "$ROOT/.cache/ms-playwright",
    "optional_generalist_gateway": {
      "host": "127.0.0.1",
      "port": 17893,
      "requires_bearer_token": true
    }
  },
  "tool_expectations": {
    "http_tools": 106,
    "manifest_base_tools": 83,
    "minimum_mcp_tools": 20
  }
}
