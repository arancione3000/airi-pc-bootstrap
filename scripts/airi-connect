#!/bin/sh
set -eu

BASE=/home/user/airi
REPO=https://github.com/arancione3000/airi-pc-bootstrap/archive/refs/heads/main.tar.gz

bootstrap_runtime() {
  mkdir -p /home/user
  rm -rf "$BASE" /tmp/airi-connect-bootstrap
  mkdir -p /tmp/airi-connect-bootstrap
  curl -fsSL "$REPO" -o /tmp/airi-connect-bootstrap/a.tar.gz
  tar -xzf /tmp/airi-connect-bootstrap/a.tar.gz -C /tmp/airi-connect-bootstrap
  TOP=$(find /tmp/airi-connect-bootstrap -mindepth 1 -maxdepth 1 -type d | head -n1)
  [ -n "$TOP" ] || { echo AIRI_PC_BOOTSTRAP_ARCHIVE_EMPTY >&2; exit 5; }
  mv "$TOP" "$BASE"
}

if [ ! -x "$BASE/computer/start.sh" ]; then
  bootstrap_runtime
fi

chmod +x "$BASE"/scripts/airi-* "$BASE"/computer/start.sh 2>/dev/null || true
exec "$BASE/scripts/airi-next-session"
