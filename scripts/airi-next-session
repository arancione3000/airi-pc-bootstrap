#!/bin/sh
set -eu
BASE=/home/user/airi
BOOTSTRAP_URL=https://github.com/arancione3000/airi-pc-bootstrap/archive/refs/heads/main.tar.gz

bootstrap_code() {
  rm -rf "$BASE" /tmp/airi-bootstrap
  mkdir -p /home/user /tmp/airi-bootstrap
  curl -fsSL "$BOOTSTRAP_URL" -o /tmp/airi-bootstrap/a.tar.gz || { echo AIRI_PC_BOOTSTRAP_DOWNLOAD_FAILED >&2; exit 3; }
  tar -xzf /tmp/airi-bootstrap/a.tar.gz -C /tmp/airi-bootstrap || { echo AIRI_PC_BOOTSTRAP_ARCHIVE_INVALID >&2; exit 4; }
  TOP=$(find /tmp/airi-bootstrap -mindepth 1 -maxdepth 1 -type d | head -n1)
  [ -n "$TOP" ] || { echo AIRI_PC_BOOTSTRAP_ARCHIVE_EMPTY >&2; exit 5; }
  mv "$TOP" "$BASE"
}

if [ ! -x "$BASE/computer/start.sh" ]; then bootstrap_code; fi

# Recreate local Git metadata if an archive-based bootstrap left no .git.
if ! git -C "$BASE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  TMPG=/tmp/airi-git-hydrate
  rm -rf "$TMPG"
  git init -q "$TMPG"
  git -C "$TMPG" remote add origin https://github.com/arancione3000/airi-pc-bootstrap.git
  git -C "$TMPG" fetch -q --depth=1 origin main || { echo AIRI_PC_GIT_FETCH_FAILED >&2; exit 6; }
  rm -rf "$BASE/.git"
  cp -a "$TMPG/.git" "$BASE/.git"
  git -C "$BASE" config user.name 'Airi-PC Agent'
  git -C "$BASE" config user.email 'airi-pc-agent@users.noreply.github.com'
  git -C "$BASE" remote set-url origin https://github.com/arancione3000/airi-pc-bootstrap.git
  git -C "$BASE" reset -q --mixed origin/main
  git -C "$BASE" branch -M main
fi

git -C "$BASE" config user.name 'Airi-PC Agent'
git -C "$BASE" config user.email 'airi-pc-agent@users.noreply.github.com'
chmod +x "$BASE"/scripts/airi-* "$BASE"/computer/start.sh 2>/dev/null || true
"$BASE/computer/start.sh" >/tmp/airi-next-session-status.json
cat /tmp/airi-next-session-status.json
"$BASE/scripts/airi-control" status
"$BASE/scripts/airi-control" browser-status
"$BASE/scripts/airi-control" browser-state
"$BASE/scripts/airi-selftest"
