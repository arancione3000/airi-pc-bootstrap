#!/bin/sh
set -eu
BASE=/home/user/airi
REPO=https://github.com/arancione3000/airi-pc-bootstrap/archive/refs/heads/main.tar.gz
mkdir -p /home/user
# Rebuild when missing or when the local runtime is stale.
if [ ! -f "$BASE/computer/start.sh" ]; then
  rm -rf "$BASE" /tmp/airi-bootstrap
  mkdir -p /tmp/airi-bootstrap
  curl -fsSL "$REPO" -o /tmp/airi-bootstrap/a.tar.gz
  tar -xzf /tmp/airi-bootstrap/a.tar.gz -C /tmp/airi-bootstrap
  TOP=$(find /tmp/airi-bootstrap -mindepth 1 -maxdepth 1 -type d | head -n1)
  mv "$TOP" "$BASE"
fi
chmod +x "$BASE"/scripts/airi-* "$BASE"/computer/start.sh 2>/dev/null || true
# A local session must not inherit an old remote-authenticated Airi process.
pkill -f '/home/user/airi/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 9010' 2>/dev/null || true
rm -f "$BASE/.mcp_token"
sh "$BASE/computer/start.sh"
# Verify locally; agent.py should see unauthenticated local MCP.
python3 "$BASE/scripts/airi-agent.py" 2>/dev/null || true
curl -fsS http://127.0.0.1:9010/status
